<Window x:Class="WorldCupMVVM.Views.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="World Cup MVVM - Выбор источника данных" 
        Height="300" 
        Width="500"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Выберите источник данных" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       Foreground="#333333"
                       TextAlignment="Center"
                       Margin="0,0,0,20"/>
            
            <TextBlock Text="Вы можете загрузить тестовые данные или использовать данные из базы данных" 
                       FontSize="14" 
                       Foreground="#666666"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,0,30"/>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Name="TestDataButton"
                        Width="150" 
                        Height="50"
                        Background="#4CAF50"
                        Foreground="White"
                        FontSize="14"
                        FontWeight="Bold"
                        Content="Тестовые данные"
                        Click="TestDataButton_Click"
                        Margin="0,0,20,0"/>
                
                <Button Name="DatabaseButton"
                        Width="150" 
                        Height="50"
                        Background="#2196F3"
                        Foreground="White"
                        FontSize="14"
                        FontWeight="Bold"
                        Content="Данные из БД"
                        Click="DatabaseButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
