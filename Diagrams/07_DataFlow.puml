@startuml DataFlow
!theme plain
skinparam backgroundColor #FEFEFE
skinparam classBackgroundColor #F0F0F0
skinparam classBorderColor #333333
skinparam arrowColor #333333

actor User

User --> CountryView : 1. Вводит данные\n(название страны)

CountryView --> CountryViewModel : 2. Binding передаёт\nданные в ViewModel

CountryViewModel --> RelayCommand : 3. Нажимает кнопку\n"Сохранить"

RelayCommand --> CountryViewModel : 4. Вызывает\nSaveCommand.Execute()

CountryViewModel --> CrudService : 5. Вызывает\nSaveCountryAsync(country)

CrudService --> ICountryRepository : 6. Вызывает\nAddAsync(country)

ICountryRepository --> CountryRepository : 7. Реализация\nметода AddAsync

CountryRepository --> PostgreSQL : 8. Выполняет\nINSERT запрос

PostgreSQL --> CountryRepository : 9. Возвращает\nновый ID

CountryRepository --> CrudService : 10. Возвращает\nTask<Country>

CrudService --> CountryViewModel : 11. Возвращает\nрезультат

CountryViewModel --> CountryViewModel : 12. Обновляет\nObservableCollection

CountryViewModel --> CountryView : 13. Вызывает\nPropertyChanged

CountryView --> User : 14. Отображает\nновую страну в DataGrid

@enduml
