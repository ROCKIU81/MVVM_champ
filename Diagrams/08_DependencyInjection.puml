@startuml DependencyInjection
!theme plain
skinparam backgroundColor #FEFEFE
skinparam classBackgroundColor #F0F0F0
skinparam classBorderColor #333333
skinparam arrowColor #333333

package "DEPENDENCY INJECTION CONTAINER" {
    class ServiceContainer {
        - serviceProvider: IServiceProvider
        --
        + RegisterRepositories(): void
        + RegisterServices(): void
        + RegisterViewModels(): void
        + GetService<T>(): T
    }
}

package "REPOSITORIES" {
    interface ICountryRepository
    interface IChampionshipRepository
    interface IMatchRepository
    interface IPersonRepository
    interface IGoalRepository
    interface IGoalTypeRepository
    interface IPlayerSquadRepository
    interface ICoachMatchRepository
    
    class CountryRepository
    class ChampionshipRepository
    class MatchRepository
    class PersonRepository
    class GoalRepository
    class GoalTypeRepository
    class PlayerSquadRepository
    class CoachMatchRepository
}

package "SERVICES" {
    class CrudService
    class StatisticsService
}

package "VIEWMODELS" {
    class MainViewModel
    class CountryViewModel
    class ChampionshipViewModel
    class MatchViewModel
    class PersonViewModel
    class GoalViewModel
    class GoalTypeViewModel
    class PlayerSquadViewModel
    class CoachMatchViewModel
    class StatisticsViewModel
}

package "DATABASE CONTEXT" {
    class ApplicationDbContext
}

' ServiceContainer регистрирует репозитории
ServiceContainer --> ICountryRepository : Register
ServiceContainer --> IChampionshipRepository : Register
ServiceContainer --> IMatchRepository : Register
ServiceContainer --> IPersonRepository : Register
ServiceContainer --> IGoalRepository : Register
ServiceContainer --> IGoalTypeRepository : Register
ServiceContainer --> IPlayerSquadRepository : Register
ServiceContainer --> ICoachMatchRepository : Register

' Репозитории регистрируют реализации
ICountryRepository <|.. CountryRepository
IChampionshipRepository <|.. ChampionshipRepository
IMatchRepository <|.. MatchRepository
IPersonRepository <|.. PersonRepository
IGoalRepository <|.. GoalRepository
IGoalTypeRepository <|.. GoalTypeRepository
IPlayerSquadRepository <|.. PlayerSquadRepository
ICoachMatchRepository <|.. CoachMatchRepository

' ServiceContainer регистрирует сервисы
ServiceContainer --> CrudService : Register
ServiceContainer --> StatisticsService : Register

' Сервисы зависят от репозиториев
CrudService --> ICountryRepository : Inject
CrudService --> IChampionshipRepository : Inject
CrudService --> IMatchRepository : Inject
CrudService --> IPersonRepository : Inject
CrudService --> IGoalRepository : Inject
CrudService --> IGoalTypeRepository : Inject
CrudService --> IPlayerSquadRepository : Inject
CrudService --> ICoachMatchRepository : Inject

StatisticsService --> IGoalRepository : Inject
StatisticsService --> IMatchRepository : Inject
StatisticsService --> IChampionshipRepository : Inject
StatisticsService --> IGoalTypeRepository : Inject

' ServiceContainer регистрирует ViewModels
ServiceContainer --> MainViewModel : Register
ServiceContainer --> CountryViewModel : Register
ServiceContainer --> ChampionshipViewModel : Register
ServiceContainer --> MatchViewModel : Register
ServiceContainer --> PersonViewModel : Register
ServiceContainer --> GoalViewModel : Register
ServiceContainer --> GoalTypeViewModel : Register
ServiceContainer --> PlayerSquadViewModel : Register
ServiceContainer --> CoachMatchViewModel : Register
ServiceContainer --> StatisticsViewModel : Register

' ViewModels зависят от сервисов
CountryViewModel --> CrudService : Inject
ChampionshipViewModel --> CrudService : Inject
MatchViewModel --> CrudService : Inject
PersonViewModel --> CrudService : Inject
GoalViewModel --> CrudService : Inject
GoalTypeViewModel --> CrudService : Inject
PlayerSquadViewModel --> CrudService : Inject
CoachMatchViewModel --> CrudService : Inject
StatisticsViewModel --> StatisticsService : Inject

' Репозитории зависят от DbContext
CountryRepository --> ApplicationDbContext : Inject
ChampionshipRepository --> ApplicationDbContext : Inject
MatchRepository --> ApplicationDbContext : Inject
PersonRepository --> ApplicationDbContext : Inject
GoalRepository --> ApplicationDbContext : Inject
GoalTypeRepository --> ApplicationDbContext : Inject
PlayerSquadRepository --> ApplicationDbContext : Inject
CoachMatchRepository --> ApplicationDbContext : Inject

@enduml
