@startuml MVVMArchitecture
!theme plain
skinparam backgroundColor #FEFEFE
skinparam classBackgroundColor #F0F0F0
skinparam classBorderColor #333333
skinparam arrowColor #333333

package "VIEW LAYER" {
    class MainWindow
    class CountryView
    class ChampionshipView
    class MatchView
    class PersonView
    class GoalView
    class GoalTypeView
    class PlayerSquadView
    class CoachMatchView
    class StatisticsView
}

package "VIEWMODEL LAYER" {
    class BaseViewModel
    class MainViewModel
    class CountryViewModel
    class ChampionshipViewModel
    class MatchViewModel
    class PersonViewModel
    class GoalViewModel
    class GoalTypeViewModel
    class PlayerSquadViewModel
    class CoachMatchViewModel
    class StatisticsViewModel
    class RelayCommand
}

package "BUSINESS LOGIC LAYER" {
    class CrudService
    class StatisticsService
}

package "DATA ACCESS LAYER" {
    interface ICountryRepository
    interface IChampionshipRepository
    interface IMatchRepository
    interface IPersonRepository
    interface IGoalRepository
    interface IGoalTypeRepository
    interface IPlayerSquadRepository
    interface ICoachMatchRepository
    
    class CountryRepository
    class ChampionshipRepository
    class MatchRepository
    class PersonRepository
    class GoalRepository
    class GoalTypeRepository
    class PlayerSquadRepository
    class CoachMatchRepository
}

package "MODEL LAYER" {
    class Country
    class Championship
    class Match
    class Person
    class Goal
    class GoalType
    class PlayerSquad
    class CoachMatch
}

' VIEW to VIEWMODEL bindings
MainWindow --> MainViewModel : DataContext
CountryView --> CountryViewModel : DataContext
ChampionshipView --> ChampionshipViewModel : DataContext
MatchView --> MatchViewModel : DataContext
PersonView --> PersonViewModel : DataContext
GoalView --> GoalViewModel : DataContext
GoalTypeView --> GoalTypeViewModel : DataContext
PlayerSquadView --> PlayerSquadViewModel : DataContext
CoachMatchView --> CoachMatchViewModel : DataContext
StatisticsView --> StatisticsViewModel : DataContext

' VIEWMODEL inheritance
BaseViewModel <|-- MainViewModel
BaseViewModel <|-- CountryViewModel
BaseViewModel <|-- ChampionshipViewModel
BaseViewModel <|-- MatchViewModel
BaseViewModel <|-- PersonViewModel
BaseViewModel <|-- GoalViewModel
BaseViewModel <|-- GoalTypeViewModel
BaseViewModel <|-- PlayerSquadViewModel
BaseViewModel <|-- CoachMatchViewModel
BaseViewModel <|-- StatisticsViewModel

' VIEWMODEL composition
MainViewModel *-- CountryViewModel
MainViewModel *-- ChampionshipViewModel
MainViewModel *-- MatchViewModel
MainViewModel *-- PersonViewModel
MainViewModel *-- GoalViewModel
MainViewModel *-- GoalTypeViewModel
MainViewModel *-- PlayerSquadViewModel
MainViewModel *-- CoachMatchViewModel
MainViewModel *-- StatisticsViewModel

' VIEWMODEL to RelayCommand
CountryViewModel --> RelayCommand : LoadCommand
CountryViewModel --> RelayCommand : SaveCommand
CountryViewModel --> RelayCommand : DeleteCommand
CountryViewModel --> RelayCommand : ClearCommand

MatchViewModel --> RelayCommand : LoadCommand
MatchViewModel --> RelayCommand : SaveCommand
MatchViewModel --> RelayCommand : DeleteCommand
MatchViewModel --> RelayCommand : ClearCommand

StatisticsViewModel --> RelayCommand : LoadStatisticsCommand
StatisticsViewModel --> RelayCommand : RefreshCommand

' VIEWMODEL to Business Logic
CountryViewModel --> CrudService : SaveCountryAsync
CountryViewModel --> CrudService : DeleteCountryAsync

MatchViewModel --> CrudService : SaveMatchAsync
MatchViewModel --> CrudService : DeleteMatchAsync

GoalViewModel --> CrudService : SaveGoalAsync
GoalViewModel --> CrudService : DeleteGoalAsync

StatisticsViewModel --> StatisticsService : GetTopScorersAsync
StatisticsViewModel --> StatisticsService : GetGoalsByTypeAsync
StatisticsViewModel --> StatisticsService : GetMatchesByChampionshipAsync
StatisticsViewModel --> StatisticsService : GetTeamStatisticsAsync

' Business Logic to Data Access
CrudService --> ICountryRepository
CrudService --> IChampionshipRepository
CrudService --> IMatchRepository
CrudService --> IPersonRepository
CrudService --> IGoalRepository
CrudService --> IGoalTypeRepository
CrudService --> IPlayerSquadRepository
CrudService --> ICoachMatchRepository

StatisticsService --> IGoalRepository
StatisticsService --> IMatchRepository
StatisticsService --> IChampionshipRepository
StatisticsService --> IGoalTypeRepository

' Data Access to Implementation
ICountryRepository <|.. CountryRepository
IChampionshipRepository <|.. ChampionshipRepository
IMatchRepository <|.. MatchRepository
IPersonRepository <|.. PersonRepository
IGoalRepository <|.. GoalRepository
IGoalTypeRepository <|.. GoalTypeRepository
IPlayerSquadRepository <|.. PlayerSquadRepository
ICoachMatchRepository <|.. CoachMatchRepository

' Data Access to Models
CountryRepository --> Country
ChampionshipRepository --> Championship
MatchRepository --> Match
PersonRepository --> Person
GoalRepository --> Goal
GoalTypeRepository --> GoalType
PlayerSquadRepository --> PlayerSquad
CoachMatchRepository --> CoachMatch

@enduml
